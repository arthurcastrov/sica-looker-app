	measure $VG_provisiones_var =
			
			var a = CALCULATE([$VG_provisiones])
			var b = CALCULATE([$VG_provisiones],PREVIOUSMONTH('calendar'[Date]))
			var division = DIVIDE(a-b,a,0)
			var formato = FORMAT(division, "0.00%")
			var result = IF(division < 0, "▼" & formato, "▲" & formato)
			RETURN
			IF(ISBLANK(result), 0, result)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vision_del_grupo
		lineageTag: 5efdcd74-579b-4dbc-84bd-f15d8401ddb9

