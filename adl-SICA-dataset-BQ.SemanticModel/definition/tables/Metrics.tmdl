	measure $VG_cartera_x_entidad =
			
			var a = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 16, sica_niif_entidades[grupo] = "Grupo Aval") /1000000
			RETURN
			IF(ISBLANK(a), 0, a)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Vision_del_grupo
		lineageTag: f61f1136-6780-4201-9ba8-4376e4b50fbb

	measure $VG_cartera_total_bancos =
			
			var a = CALCULATE(sum(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 16, sica_niif_entidades[Entidad] = "Total Bancos", REMOVEFILTERS(tabla_bancos[entidad]),REMOVEFILTERS(sica_niif_entidades[grupo]) ) / 1000000
			return
			IF(ISBLANK(a), 0, a)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Vision_del_grupo
		lineageTag: 64d69558-1dfa-4031-9905-60d3fbaab168

	measure $VG_market_share_cartera =
			
			DIVIDE([$VG_cartera_x_entidad], [$VG_cartera_total_bancos], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Vision_del_grupo
		lineageTag: 2c651902-03c2-4fdd-bb5b-a8d0e8e4536c

	measure $VG_ROE =
			
			var mes = SELECTEDVALUE(sica_niif_entidades[num_mes])
			var a = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 12)
			var b = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 10)
			var c = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 4)
			var d = IFERROR((((DIVIDE(b, c, 0) + 1) ^ (1 / mes) - 1) + 1) ^ 12 - 1, 0)
			RETURN
			IF(ISFILTERED(tabla_bancos[entidad]), a, d)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Vision_del_grupo
		lineageTag: 662aa74d-befd-440c-a5a1-5f1a490fda4f

	measure $VG_Costo_fondeo =
			
			var mes = SELECTEDVALUE(sica_niif_entidades[num_mes])
			var a = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 8)
			var b = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 25 ||  sica_niif_entidades[identificador] = 28 || sica_niif_entidades[identificador] = 29 || sica_niif_entidades[identificador] = 39)
			var c = DIVIDE(a, b, 0)
			RETURN
			IFERROR((((c + 1) ^ (1 / mes) - 1) + 1) ^ 12 - 1, 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Vision_del_grupo
		lineageTag: f6488fea-68bb-43b6-b409-4430beedc138

	measure $VG_ROA =
			
			var mes = SELECTEDVALUE(sica_niif_entidades[num_mes])
