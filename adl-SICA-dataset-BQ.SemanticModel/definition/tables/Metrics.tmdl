	measure 'Usuario Animado Azul Sutil' = ```
			
			VAR User = USERPRINCIPALNAME()
			var user_name = LOOKUPVALUE(sica_roles[nombre_corto],sica_roles[correo],[$_usuario])
			VAR HTML_Code = 
			    "<style>" & 
			        "/* 1. Animación del FONDO (Movimiento y Desaparición) */" &
			        "@keyframes fadeBackground {" & 
			            "0% { opacity: 1; background-position: 0% 0%; }" & 
			            "50% { opacity: 1; background-position: 100% 100%; }" & 
			            "100% { opacity: 0; }" & /* 4 segundos: Fondo desaparece */
			        "}" &
			        
			        "/* 2. Animación del TEXTO (Aparición Rápida en 0.30s) */" &
			        "@keyframes fadeInText {" & 
			            "0% { opacity: 0; }" & 
			            "100% { opacity: 1; }" & 
			        "}" &
			        
			        "/* 3. Reset y estructura para responsividad */" &
			        "body, html { margin: 0; padding: 0; height: 100%; }" &
			        ".main-wrapper { position: relative; width: 100%; height: 100%; }" & 
			        
			        "/* 4. Estilos del Fondo */" &
			        ".animated-background {" &
			            "position: absolute; top: 0; left: 0; width: 100%; height: 100%;" &
			            /* CAMBIO CLAVE: Degradado de Azul con 30% Opacidad y 20% de participación */
			            "background: linear-gradient(-45deg, rgba(14, 29, 75, 0.3) 0%, rgba(14, 29, 75, 0.3) 20%, transparent 80%, transparent 100%);" & 
			            "background-size: 300% 300%;" & 
			            "animation: fadeBackground 4s ease-in-out 1 forwards;" & 
			            "border-radius: 5px; z-index: 1;" & 
			        "}" &
			
			        "/* 5. Estilos del Texto (Fuente y Alineación) */" &
			        ".text-container {" &
			            "text-align: left; width: 100%; height: 100%;" & 
			            "padding: 10px; box-sizing: border-box;" & 
			            "font-family: ""DIN Light"", sans-serif; color: #333333;" & 
			            "z-index: 2; position: relative;" &
			            
			            "/* Aplicación del Fade-in del Texto */" &
			            "opacity: 0;" & 
			            "animation: fadeInText 0.30s ease-out 1 forwards;" & /* Animación rápida del texto */
			        "}" &
			    "</style>" &
			    
			    "<div class='main-wrapper'>" &
			        /* La capa de fondo animado */
			        "<div class='animated-background'></div>" &
			        
			        /* La capa de texto con fade-in */
			        "<div class='text-container'>" &
			            "<span>Bienvenido: </span>" &
			            "<span>" & user_name & "</span>" & 
			        "</div>" &
			    "</div>"
			RETURN
			    HTML_Code
			```
		displayFolder: Vision_del_grupo
		lineageTag: 90c01e85-116b-4a05-ace7-9195610884b8

