			var producto = SELECTEDVALUE(eco_aval_fct_margen_agg_productos[codigo_producto])
			var a  = CALCULATE(SUM(eco_aval_fct_margen_agg_productos[ingreso])/1000000)
			var b  = CALCULATE(SUM(eco_aval_fct_margen_agg_productos[costo])/1000000)
			var result = IF(entidad = "BPOP" && producto <= "0103",b,a)
