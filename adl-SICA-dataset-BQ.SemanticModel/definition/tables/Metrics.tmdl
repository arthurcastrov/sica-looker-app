	measure $VG_%_NIM =
			
			var mes = SELECTEDVALUE(sica_niif_entidades[num_mes])
			var mes_actual = CALCULATE([$mokup_total_activos], sica_niif_entidades[grupo] = "Grupo Aval")
			var a = [$VG_NIM]
			var c = DIVIDE(a, mes_actual, 0)
			RETURN
			IFERROR((((c + 1) ^ (1 / mes) - 1) + 1) ^ 12 - 1, 0)
