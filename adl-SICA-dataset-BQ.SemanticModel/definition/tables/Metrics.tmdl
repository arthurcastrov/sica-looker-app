	measure $VG_cartera_vencida_modalidad = ```
			
			var modalidad = SELECTEDVALUE(tbl_modalidad_cartera[modalidad])
			var total = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 22) 
			var cartera_consumo = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 48)  
			var cartera_comercial = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 47)  
			var cartera_vivienda = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 49)  
			var cartera_microcredito = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 62) 
			var result = SWITCH(modalidad,"Consumo",cartera_consumo,"Comercial",cartera_comercial,
			"Vivienda",cartera_vivienda,"Microcredito",cartera_microcredito,total)
			RETURN
			IF(ISBLANK(result), 0, result /1000000)
