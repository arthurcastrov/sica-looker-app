			var porc_part_act_eco = IF(banco <> "Grupo Aval",MAXX(TOPN(1,SUMMARIZE(eco_aval_dim_ciiu,eco_aval_dim_ciiu[ciiu_tp_ds],"participacion",[%_part_aval_filtro]),[participacion]),[participacion]),MAXX(TOPN(1,SUMMARIZE(eco_aval_dim_ciiu,eco_aval_dim_ciiu[ciiu_tp_ds],"participacion",[%_part_aval]),[participacion]),[participacion]))
			
			var part_departamento = IF(banco <> "Grupo Aval",MAXX(TOPN(1,SUMMARIZE('8 eco_aval_ael_clientes_aval','8 eco_aval_ael_clientes_aval'[departamentoempleado],"participacion",[%_part_aval_filtro]),[participacion]),'8 eco_aval_ael_clientes_aval'[departamentoempleado]),MAXX(TOPN(1,SUMMARIZE('8 eco_aval_ael_clientes_aval','8 eco_aval_ael_clientes_aval'[departamentoempleado],"participacion",[%_part_aval]),[participacion]),'8 eco_aval_ael_clientes_aval'[departamentoempleado]))
			
