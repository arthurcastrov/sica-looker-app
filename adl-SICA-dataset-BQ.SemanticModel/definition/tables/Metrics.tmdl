	measure $VG_rendimiento_cartera =
			
			var mes = SELECTEDVALUE(sica_niif_entidades[num_mes])
			var ingresos = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 6, sica_niif_entidades[grupo] = "Grupo Aval")
			var cartera = [$VG_cartera_x_entidad_avg_ytd]
			var c = DIVIDE(ingresos, cartera, 0)
