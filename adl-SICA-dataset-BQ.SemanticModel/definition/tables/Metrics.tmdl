	measure $depositos_rpt_saldo_txt_saldo_segmento =
			
			var banco_mayor_saldo = MAXX(TOPN(1,SUMMARIZE(eco_aval_fct_depositos_reporte,eco_aval_fct_depositos_reporte[segmento],"Saldo",[$depositos_rpt_saldo_producto]),[Saldo],DESC),eco_aval_fct_depositos_reporte[segmento])
			
			var clientes_banco_mayor_saldo = MAXX(TOPN(1,SUMMARIZE(eco_aval_fct_depositos_reporte,eco_aval_fct_depositos_reporte[segmento],"Clientes",[$depositos_rpt_clientes_mes]),[Clientes],DESC),[Clientes])
			
			var banco_mayor_saldo_cliente = MAXX(TOPN(1,SUMMARIZE(eco_aval_fct_depositos_reporte,eco_aval_fct_depositos_reporte[segmento],"Saldo",[$depositos_rpt_saldo_prom_cliente]),[Saldo],DESC),eco_aval_fct_depositos_reporte[segmento])
			
			var saldo_cliente_banco_mayor = MAXX(TOPN(1,SUMMARIZE(eco_aval_fct_depositos_reporte,eco_aval_fct_depositos_reporte[segmento],"Saldo",[$depositos_rpt_saldo_prom_cliente]),[Saldo],DESC),[Saldo])
			
			var clientes_banco_saldo__por_cliente = MAXX(TOPN(1,SUMMARIZE(eco_aval_fct_depositos_reporte,eco_aval_fct_depositos_reporte[segmento],"Clientes",[$depositos_rpt_clientes_mes]),[Clientes],DESC),[Clientes])
			var a = "El segmento con mayor saldo total es " & banco_mayor_saldo & " con un cantidad de: "  & FORMAT(clientes_banco_mayor_saldo,"#,##0")  & " clientes, sin embargo, el segmento con mayor saldo promedio por cliente es " & banco_mayor_saldo_cliente & " con una cantidad de :"  & FORMAT(clientes_banco_saldo__por_cliente,"#,##0") & " clientes"
			RETURN
			a
		displayFolder: Saldos
		lineageTag: 780143db-b185-430e-9bd7-7bdb1e345c55

