	measure $VG_Ratio_Eficiencia =
			
			var a = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 17 ||  sica_niif_entidades[identificador] = 42 || sica_niif_entidades[identificador] = 43 || sica_niif_entidades[identificador] = 44)
			var b = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 11)
			var c = CALCULATE(SUM(sica_niif_entidades[valor]), sica_niif_entidades[identificador] = 45)
			var deno = b + c
			var final = DIVIDE(a, deno, 0)
