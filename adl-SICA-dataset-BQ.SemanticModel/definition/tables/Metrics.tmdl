	measure $IZ_18_1_visitas_ejecutadas_variacion = ```
			
			VAR entidadSeleccionada = SELECTEDVALUE(tabla_bancos[entidad])
			VAR semanaActual = MAX(indicadores_zeus_seguimiento[semana_num])
			
			-- Valor normal (semana actual)
			VAR valorSemanaActual =
			    CALCULATE(
			        SUM(indicadores_zeus_seguimiento[valor]),
			        indicadores_zeus_dim_kpis[id] = 18,
			        indicadores_zeus_seguimiento[unidad_de_medida] = "# visitas ejecutadas"
			    )
			
			-- Valor normal webinar (semana actual)
			VAR valorSemanaActualWebinar =
			    CALCULATE(
			        SUM(indicadores_zeus_seguimiento[valor]),
			        indicadores_zeus_dim_kpis[id] = 24,
			        indicadores_zeus_seguimiento[unidad_de_medida] = "# visitas ejecutadas webinar"
			    )
			
			-- Valor semana anterior (solo para otras entidades que no sean BAVV y no sea semana 1)
			VAR valorSemanaAnterior =
			    CALCULATE(
			        SUM(indicadores_zeus_seguimiento[valor]),
			        indicadores_zeus_dim_kpis[id] = 18,
			        indicadores_zeus_seguimiento[unidad_de_medida] = "# visitas ejecutadas",
			        indicadores_zeus_seguimiento[semana_num] = semanaActual - 1,
			        REMOVEFILTERS(tabla_semanas[Semana]),
			        REMOVEFILTERS(indicadores_zeus_semanas[semana])
			    )
			
			VAR valorSemanaAnterior_webinar =
			    CALCULATE(
			        SUM(indicadores_zeus_seguimiento[valor]),
			        indicadores_zeus_dim_kpis[id] = 24,
			        indicadores_zeus_seguimiento[unidad_de_medida] = "# visitas ejecutadas webinar",
			        indicadores_zeus_seguimiento[semana_num] = semanaActual - 1,
			        REMOVEFILTERS(tabla_semanas[Semana]),
			        REMOVEFILTERS(indicadores_zeus_semanas[semana])
			    )
			
			var suma = valorSemanaActual + valorSemanaActualWebinar
			var suma_anterior = valorSemanaAnterior + valorSemanaAnterior_webinar
			
			-- Resultado según reglas
			VAR resultado =
			    SWITCH(
			        TRUE(),
			        semanaActual = 1, suma,
			        suma - suma_anterior
			    )
			
			RETURN
			IF(ISBLANK(resultado), 0,resultado)
			
			```
		formatString: #,0
		displayFolder: Indicadores Zeus
		lineageTag: dfea0765-ccaa-4137-a83f-8badbd7a5f03

		annotation PBI_FormatHint = {"isDecimal":true}

	measure $IZ_18_2_visitas_planeadas_variacion = ```
			
			VAR entidadSeleccionada = SELECTEDVALUE(tabla_bancos[entidad])
			VAR semanaActual = MAX(indicadores_zeus_seguimiento[semana_num])
			
			-- Valor normal (semana actual)
			VAR valorSemanaActual =
			    CALCULATE(
			        SUM(indicadores_zeus_seguimiento[valor]),
			        indicadores_zeus_dim_kpis[id] = 18,
			        indicadores_zeus_seguimiento[unidad_de_medida] = "# visitas planeadas"
			    )
			-- Valor normal Webinar (semana actual)
			VAR valorSemanaActualWebinar =
			    CALCULATE(
			        SUM(indicadores_zeus_seguimiento[valor]),
			        indicadores_zeus_dim_kpis[id] = 24,
			        indicadores_zeus_seguimiento[unidad_de_medida] = "# visitas planeadas webinar"
			    )
			
			-- Valor semana anterior (solo para otras entidades que no sean BAVV y no sea semana 1)
			VAR valorSemanaAnterior =
			    CALCULATE(
			        SUM(indicadores_zeus_seguimiento[valor]),
			        indicadores_zeus_dim_kpis[id] = 18,
			        indicadores_zeus_seguimiento[unidad_de_medida] = "# visitas planeadas",
			        indicadores_zeus_seguimiento[semana_num] = semanaActual - 1,
			        REMOVEFILTERS(tabla_semanas[Semana])
			    )
			-- Valor semana anterior (solo para otras entidades que no sean BAVV y no sea semana 1)
			VAR valorSemanaAnteriorWebinar =
			    CALCULATE(
			        SUM(indicadores_zeus_seguimiento[valor]),
			        indicadores_zeus_dim_kpis[id] = 24,
			        indicadores_zeus_seguimiento[unidad_de_medida] = "# visitas planeadas webinar",
			        indicadores_zeus_seguimiento[semana_num] = semanaActual - 1,
			        REMOVEFILTERS(tabla_semanas[Semana])
			    )
			var suma = valorSemanaActual + valorSemanaActualWebinar
			var suma_anterior = valorSemanaAnterior + valorSemanaAnteriorWebinar
			
			-- Resultado según reglas
			VAR resultado =
			    SWITCH(
			        TRUE(),
			        semanaActual = 1, suma,
			        suma_anterior
			    )
			
			RETURN
			IF(ISBLANK(resultado), 0,resultado)
			
			```
		formatString: #,0
		displayFolder: Indicadores Zeus
		lineageTag: 75bfe062-a641-4ae6-a799-5c54a623093e

		annotation PBI_FormatHint = {"isDecimal":true}

