	measure $VG_cartera_x_entidad_avg_ytd = ```
			
			VAR TablaFiltrada =
			    CALCULATETABLE(
			        sica_niif_entidades,
			        -- 1. Filtros de hechos (booleano)
			        sica_niif_entidades[identificador] = 16,
			        sica_niif_entidades[grupo] = "Grupo Aval"
			    )
			VAR FechaYTD =
			    -- 2. Aplicar el filtro de tiempo (tabla de fechas) a la TablaFiltrada
			    CALCULATETABLE(
			        TablaFiltrada,
			        DATESYTD('calendar'[Date]) -- <--- ¡Solución! DATESYTD es un filtro independiente
			    )
			VAR TotalesPorMes =
			    SUMMARIZE(
			        FechaYTD,
			        'calendar'[YYYY_MM],
			        "TotalMes", SUM(sica_niif_entidades[valor])
			    )
			VAR PromedioYTD =
			    AVERAGEX(TotalesPorMes, [TotalMes])
			RETURN
			    IF(ISBLANK(PromedioYTD), 0, PromedioYTD)
			
			```
		displayFolder: Vision_del_grupo
		lineageTag: b39decde-ca2c-4a8f-a343-d2a460ee561f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

