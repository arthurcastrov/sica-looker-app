			var part_ciudad= IF(banco <> "Grupo Aval",MAXX(TOPN(1,SUMMARIZE('8 eco_aval_ael_clientes_aval','8 eco_aval_ael_clientes_aval'[ciudadempleado],"participacion",[%_part_aval_filtro]),[participacion]),'8 eco_aval_ael_clientes_aval'[ciudadempleado]),MAXX(TOPN(1,SUMMARIZE('8 eco_aval_ael_clientes_aval','8 eco_aval_ael_clientes_aval'[ciudadempleado],"participacion",[%_part_aval]),[participacion]),'8 eco_aval_ael_clientes_aval'[ciudadempleado]))
			
