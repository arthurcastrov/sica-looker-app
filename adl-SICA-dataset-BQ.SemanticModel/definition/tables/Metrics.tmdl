	measure $depositos_rpt_cuentas_activas_var =
			
			var a = [$depositos_rpt_cuentas_activas]
			var b = CALCULATE([$depositos_rpt_cuentas_activas],PREVIOUSMONTH('calendar'[Date]))
			var division = DIVIDE(a-b,b,0)
			var format_division = FORMAT(division,"0.0%")
			var result = IF(division < 0, "▼" & format_division, "▲" & format_division)
			return
			IF(ISBLANK(result),0,result)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Saldos
		lineageTag: 3f569cdb-c035-4c6f-926c-d5b00cc4b867

	measure $depositos_rpt_cuentas_activas_var_color =
			
			var a = [$depositos_rpt_cuentas_activas]
			var b = CALCULATE([$depositos_rpt_cuentas_activas],PREVIOUSMONTH('calendar'[Date]))
			var division = DIVIDE(a-b,b,0)
			var format_division = FORMAT(division,"0.0%")
			var result = IF(division > 0,"#449c4a",IF(division = -1,"#449c4a","#e63946"))
			return
			result
		displayFolder: Saldos
		lineageTag: b302fe89-06a9-4486-abab-a2a2e3a63139

