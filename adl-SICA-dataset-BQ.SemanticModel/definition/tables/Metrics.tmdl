	measure fechas_act_fuentes =
			
			var Actual =  IF(ISINSCOPE(fecha_act_fuentes[Indicador])=TRUE(),SELECTEDVALUE(fecha_act_fuentes[Llave]),SELECTEDVALUE(fecha_act_fuentes[Fuente]))
			// var Actual = SELECTEDVALUE(fecha_act_fuentes[Fuente])
			var fecha_pn =  FORMAT(MAX('1. eco_avl_fct_clientes'[date_cruce]), "MMMM YYYY","ES-es")
			var fecha_pj = FORMAT(MAX('6 eco_aval_fct_clientes_pj'[date_cruce]), "MMMM YYYY","ES-es")
			var fecha_buro = FORMAT(MAX('4 eco_aval_buro_aval'[date_cruce]), "MMMM YYYY","ES-es")
			var fecha_buro_pj = FORMAT(MAX(eco_aval_buro_aval_PJ[date_cruce]), "MMMM YYYY","ES-es")
			var fecha_margen_general = "Despliegue ↓"
			var fecha_margen_bbog = [$txt_fecha_act_margen_bbog]
			var fecha_margen_bocc = [$txt_fecha_act_margen_bocc]
			var fecha_margen_bpop = [$txt_fecha_act_margen_bpop]
			var fecha_margen_bavv = [$txt_fecha_act_margen_bavv]
			var fecha_aportes = FORMAT(MAX('8 eco_aval_ael_clientes_aval'[date_cruce]), "MMMM YYYY","ES-es")
			var fecha_tc_productos = FORMAT(MAX(eco_aval_tc_productos[fecha_corte]), "MMMM YYYY","ES-es")
			var fecha_tc_sfc = FORMAT(MAX(eco_aval_sfc_tc[fechacorte]), "MMMM YYYY","ES-es")
			
			return
			SWITCH(Actual,
			"Persona Natural (MDM - CRM)",fecha_pn,
			"Persona Juridica (MDM - CRM)",fecha_pj,
			"Margen",fecha_margen_general,
			"Margen-Bogota",fecha_margen_bbog,
			"Margen-Occidente",fecha_margen_bocc,
			"Margen-Popular",fecha_margen_bpop,
			"Margen-Villas",fecha_margen_bavv,
			"Buró Persona Natural",fecha_buro,
			"Buró Persona Juridica",fecha_buro_pj,
			"Aportes",fecha_aportes,
			"Tarjeta de Crédito (TRX)",fecha_tc_productos,
			"Tarjeta de Crédito (SFC)",fecha_tc_sfc,
			"N/A")
		displayFolder: Textos
		lineageTag: abbd8a98-97d8-4a63-a10d-9a7db20c74e3

